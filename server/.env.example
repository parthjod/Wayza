NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:password@localhost:5432/wayza?connection_limit=15&pool_timeout=10
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-64-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-64-chars-min
OTP_HMAC_SECRET=change-me-otp-hmac-secret-64-chars-min

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=wayza-avatars
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-id.cloudfront.net
AWS_SES_FROM_EMAIL=noreply@wayza.in
AWS_SNS_SENDER_ID=WAYZA
FAST2SMS_API_KEY=your-fast2sms-api-key

ALLOWED_EMAIL_DOMAINS=mitwpu.edu.in
FRONTEND_URL=http://localhost:5173
MAX_GROUP_SIZE=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS=20
LOCATION_TTL_SECONDS=300
DATA_RETENTION_DAYS=90
